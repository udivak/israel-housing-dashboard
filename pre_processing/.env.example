# =========================================================
# Pre-processing pipeline (.env.example)
# =========================================================
#
# Copy to .env and fill values.
# Do NOT commit secrets.
#

# MongoDB (source/raw)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=israel_housing
MONGODB_RAW_COLLECTION=raw_records

# MongoDB (normalized output)
MONGODB_NORMALIZED_URI=mongodb://localhost:27017
MONGODB_NORMALIZED_DB_NAME=israel_housing
MONGODB_NORMALIZED_COLLECTION=normalized_records

# Inputs for pipelines
OSM_DATA_DIR=/data/osm
PARCEL_PATH=/data/parcel_all/PARCEL_ALL.shp

# Outputs
FEATURES_OUTPUT_CSV=/outputs/features_osm.csv
TEMPORAL_OUTPUT_XLSX=/outputs/temporal_features.xlsx

# Optional tuning
FEATURE_BATCH_SIZE=500
LOG_LEVEL=INFO

# Optional skips (set to 1/true to skip)
PIPELINE_SKIP_PROFILER=
PIPELINE_SKIP_GEOM=
PIPELINE_SKIP_NORMALIZE=
PIPELINE_SKIP_OSM=
PIPELINE_SKIP_TEMPORAL=

